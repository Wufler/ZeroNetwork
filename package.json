{
  "name": "zeronetwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:push && next build",
    "start": "next start",
    "lint": "biome check",
    "db:start": "docker-compose up -d --wait",
    "db:stop": "docker-compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "studio": "drizzle-kit studio",
    "db:reset": "docker-compose down -v && docker-compose up -d --wait && drizzle-kit push && tsx src/db/seed.ts",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
